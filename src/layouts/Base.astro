---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, type Lang } from '../config';
import { metaDescription } from '../data/content';
import { localePath } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Locale-less path, e.g. '/' or '/work/'. Drives hreflang and the EN|IT switch. */
  path: string;
  title: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;

const desc = description ?? metaDescription[lang];
const canonical = new URL(localePath(lang, path), SITE.url).href;
const enHref = new URL(localePath('en', path), SITE.url).href;
const itHref = new URL(localePath('it', path), SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  image: new URL(SITE.photo, SITE.url).href,
  worksFor: { '@type': 'Organization', name: SITE.company, url: 'https://quantyca.it' },
  address: { '@type': 'PostalAddress', addressLocality: 'Monza', addressCountry: 'IT' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Politecnico di Milano' },
  sameAs: [SITE.linkedin, SITE.github],
  knowsLanguage: ['en', 'it'],
  knowsAbout: [
    'Data Mesh', 'Data Architecture', 'Data Strategy', 'Data Governance', 'Data Products',
    'MLOps', 'Data Platforms', 'Apache Kafka', 'Apache Spark', 'Apache Iceberg',
    'Kubernetes', 'Docker', 'AWS', 'Microsoft Azure', 'MLflow', 'Python', 'SQL',
    'OpenDataMesh', 'OpenTelemetry', 'Solution Architecture',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    {/* No og:image on purpose: the old site pointed at a file that did not exist,
        so every share rendered an empty card. A real 1200x630 asset is on the TODO list;
        until it exists, a small summary card is better than a broken large one. */}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;450;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      // Applied before first paint so the manual choice never flashes the wrong theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (_) {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (_) {}
      });

      const burger = document.getElementById('burger');
      const menu = document.getElementById('mobile-menu');
      burger?.addEventListener('click', () => {
        const open = menu.dataset.open === 'true';
        menu.dataset.open = String(!open);
        burger.setAttribute('aria-expanded', String(!open));
      });
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          menu.dataset.open = 'false';
          burger?.setAttribute('aria-expanded', 'false');
        })
      );
    </script>
  </body>
</html>
