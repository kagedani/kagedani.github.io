---
import { SITE, type Lang } from '../../config';
import { t, localePath } from '../../i18n/ui';
import { about, experience, skills, interests, leadership, leadershipVoice, leadershipStory, projects } from '../../data/content';
import Todo from '../Todo.astro';
import { slugsWithStudy } from '../../lib/studies';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const withStudy = await slugsWithStudy(lang);
const studyHref = (slug: string) =>
  withStudy.has(slug) ? localePath(lang, `/work/${slug}/`) : undefined;

/** The projects a job period produced, resolved from its slug list. */
const projectsFor = (job: (typeof experience)[number]) =>
  (job.relatedProjects ?? [])
    .map((slug) => projects.find((p) => p.slug === slug))
    .filter((p): p is (typeof projects)[number] => Boolean(p));
---

<section class="page-head">
  <div class="wrap">
    <h1>{tr('page.about.title')}</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.about')}</h2>
    <div class="prose">
      {about.map((p) => <p>{p[lang]}</p>)}
    </div>
  </div>
</section>

<section class="section" id="leadership">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.leadership')}</h2>
    <p class="voice">{leadershipVoice[lang]}</p>
    <div class="lead-grid">
      {
        leadership.map((c) => (
          <div class="lead-cell">
            {c.num !== '—' && <div class="lead-num">{c.num}</div>}
            <div class="lead-head">{c.head[lang]}</div>
            <p class="lead-body">{c.body[lang]}</p>
            <Todo note={c.todo} />
          </div>
        ))
      }
    </div>
    <p class="lead-story">{leadershipStory[lang]}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.experience')}</h2>
    <div class="timeline">
      {
        experience.map((j) => {
          const related = projectsFor(j);
          return (
            <div class="tl-item" tabindex="0">
              <div class="tl-date">{j.period[lang]}</div>
              <h3 class="tl-role">{j.role[lang]}</h3>
              <div class="tl-company">{j.company[lang]}</div>
              {j.desc && j.desc[lang].split('\n\n').map((para) => <p class="tl-desc">{para}</p>)}
              <Todo note={j.todo} />

              <div class="tl-term">
                <div class="tl-term-bar" aria-hidden="true">
                  <span class="tl-term-dot" /><span class="tl-term-dot" /><span class="tl-term-dot" />
                </div>
                <div class="tl-term-body">
                  <p class="tl-term-line"><span class="tl-term-prompt">$</span> ls {j.startYear}-projects</p>
                  {
                    related.length > 0 ? (
                      related.map((p) => {
                        const href = studyHref(p.slug);
                        return href ? (
                          <a class="tl-term-entry" href={href}>{p.slug}/</a>
                        ) : (
                          <span class="tl-term-entry">{p.slug}/</span>
                        );
                      })
                    ) : (
                      <p class="tl-term-empty"># {tr('tl.empty')}</p>
                    )
                  }
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.skills')}</h2>
    {
      skills.map((g) => (
        <div class="skill-group">
          <div class="skill-label">{g.group[lang]}</div>
          <div class="skill-items">
            {g.items.map((i) => (
              <span>{i}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.interests')}</h2>
    <div class="interests">
      {
        interests.map((i) => (
          <div>
            <div class="interest-name">{i.name[lang]}</div>
            <p class="interest-body">{i.body[lang]}</p>
            <Todo note={i.todo} />
          </div>
        ))
      }
    </div>
  </div>
</section>
