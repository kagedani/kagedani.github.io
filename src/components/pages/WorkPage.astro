---
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { projects } from '../../data/content';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<section class="page-head">
  <div class="wrap">
    <h1>{tr('page.work.title')}</h1>
    <p class="lede">{tr('page.work.lede')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.work')}</h2>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} lang={lang} wide />)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{lang === 'it' ? 'Anche' : 'Also'}</h2>
    <div class="grid">
      {others.map((p) => <ProjectCard project={p} lang={lang} />)}
    </div>
  </div>
</section>
