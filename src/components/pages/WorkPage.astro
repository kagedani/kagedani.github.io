---
import type { Lang } from '../../config';
import { t, localePath } from '../../i18n/ui';
import { projects } from '../../data/content';
import ProjectCard from '../ProjectCard.astro';
import { slugsWithStudy } from '../../lib/studies';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);

const withStudy = await slugsWithStudy(lang);
const studyHref = (slug: string) =>
  withStudy.has(slug) ? localePath(lang, `/work/${slug}/`) : undefined;
---

<section class="page-head">
  <div class="wrap">
    <h1>{tr('page.work.title')}</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{tr('kicker.work')}</h2>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} lang={lang} wide href={studyHref(p.slug)} />)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="kicker">{lang === 'it' ? 'Anche' : 'Also'}</h2>
    <div class="grid">
      {others.map((p) => <ProjectCard project={p} lang={lang} href={studyHref(p.slug)} />)}
    </div>
  </div>
</section>
