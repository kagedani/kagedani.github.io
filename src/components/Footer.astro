---
import { SITE, type Lang } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <span>{SITE.name}, {SITE.location}</span>
  <span>
    <a href={SITE.github} rel="me noopener">{SITE.githubHandle}</a>
    &nbsp;·&nbsp;{tr('footer.built')}, {year}
  </span>
</footer>
