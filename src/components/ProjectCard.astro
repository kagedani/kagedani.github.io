---
import type { Lang } from '../config';
import type { Project } from '../data/content';
import { t } from '../i18n/ui';
import Todo from './Todo.astro';

interface Props {
  project: Project;
  lang: Lang;
  wide?: boolean;
}
const { project: p, lang, wide = false } = Astro.props;
const tr = t(lang);
---

<article class:list={['card', wide && 'wide']}>
  <div class="card-meta">
    <span>{p.sector[lang]}</span>·<span>{p.role[lang]}</span>
    {p.period && <>·<span>{p.period}</span></>}
    {p.ongoing && <span class="pill-ongoing">{tr('label.ongoing')}</span>}
  </div>

  <h3 class="card-title">{p.title[lang]}</h3>
  <p class="card-desc">{p.summary[lang]}</p>

  {
    p.stack.length > 0 && (
      <div class="stack">
        {p.stack.map((s) => (
          <span class="chip">{s}</span>
        ))}
      </div>
    )
  }

  <Todo note={p.todo} />
</article>
